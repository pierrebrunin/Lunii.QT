// Podcasts view: the followed podcasts on the left, the episodes of the
// selected one on the right, to import on the device.

import { Button, CheckBox, ComboBox, ListView, Palette } from "std-widgets.slint";
import { Theme, EpisodeRow, FollowedRow } from "common.slint";

// Column header: a click sorts by it, again reverses the order.
component SortHeader inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <bool> sorted;
    in property <bool> ascending;
    callback clicked();
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        width: 100%;
        text: root.text + (root.sorted ? (root.ascending ? " ▲" : " ▼") : "");
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        font-weight: 600;
        overflow: elide;
        color: area.has-hover ? Theme.selection : Palette.foreground;
    }
}

export component PodcastsView inherits HorizontalLayout {
    // followed podcasts
    in property <[FollowedRow]> followed;
    in-out property <int> current: -1;
    // selected podcast: title and details, or the error
    in property <string> header;
    // its web page, if known
    in property <string> page;
    // episodes on the device / all of them
    in property <string> count;
    // its episodes are being loaded
    in property <bool> loading;
    in property <[EpisodeRow]> rows;
    // row selected (click, arrows); its box (or Space) checks it
    property <int> selected-row: -1;
    in property <int> selected-count;
    // episodes on the device unchecked: to remove
    in property <int> remove-count;
    // 0: title, 1: duration, 2: date, 3: on the device
    in-out property <int> sort-column: 2;
    in-out property <bool> sort-ascending: false;
    // 0: one album (a menu to choose the episode), 1: one story per episode
    in-out property <int> mode;
    // a device that stories can be imported to, and no task running
    in property <bool> can-import;
    // no task running
    in property <bool> interactive;
    // "+": the dialog adding a podcast
    callback add();
    callback select(index: int);
    callback refresh();
    callback open-page();
    // right click on the address: its menu, at `position` in the window
    callback page-menu(position: Point);
    callback unfollow();
    callback mode-changed();
    callback toggle(index: int);
    callback select-all(all: bool);
    callback import();
    callback sort-changed();

    property <length> row-height: 28px;
    property <length> col-duration: 70px;
    property <length> col-date: 90px;
    property <length> col-device: 110px;

    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-ascending = !root.sort-ascending;
        } else {
            root.sort-column = column;
            // A → Z, but the newest, longest and present first
            root.sort-ascending = column == 0;
        }
        // the rows change order
        root.selected-row = -1;
        root.sort-changed();
    }

    spacing: 8px;

    // ------------------------------------------------------------ followed
    VerticalLayout {
        width: 230px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: @tr("Followed podcasts");
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "+";
                width: 36px;
                clicked => { root.add(); }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Palette.border;
            if root.followed.length == 0: Text {
                x: 10px;
                width: parent.width - 20px;
                text: @tr("Click + to add a podcast: search it by its name, or paste its address.");
                wrap: word-wrap;
                color: Theme.hidden-text;
                vertical-alignment: center;
            }
            ListView {
                for row[i] in root.followed: Rectangle {
                    height: 42px;
                    background: i == root.current ? Theme.selection : feed-area.has-hover ? #8882 : transparent;
                    feed-area := TouchArea {
                        clicked => {
                            root.selected-row = -1;
                            root.select(i);
                        }
                    }
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: row.title;
                            overflow: elide;
                            color: i == root.current ? #fff : Palette.foreground;
                        }
                        Text {
                            text: row.info;
                            font-size: 11px;
                            overflow: elide;
                            color: i == root.current ? #fff : Theme.hidden-text;
                        }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------ episodes
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 6px;
        if root.current < 0 && root.header == "": Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Palette.border;
            Text {
                width: parent.width - 40px;
                text: @tr("Choose a podcast on the left, or add one with +.");
                wrap: word-wrap;
                horizontal-alignment: center;
                color: Theme.hidden-text;
            }
        }
        if root.current >= 0 || root.header != "": HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.loading ? @tr("Loading...") : root.header;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                // click: opened; right click: a menu to copy it
                if !root.loading && root.page != "": Text {
                    text: root.page;
                    font-size: 12px;
                    overflow: elide;
                    color: #3584e4;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-page(); }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.page-menu({
                                    x: self.absolute-position.x + self.mouse-x,
                                    y: self.absolute-position.y + self.mouse-y,
                                });
                            }
                        }
                    }
                }
            }
            if root.current >= 0: VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "↻";
                        width: 36px;
                        enabled: !root.loading;
                        clicked => { root.refresh(); }
                    }
                    Button {
                        text: @tr("Unfollow");
                        enabled: root.interactive;
                        clicked => { root.unfollow(); }
                    }
                }
            }
        }
        if root.rows.length > 0: HorizontalLayout {
            spacing: 6px;
            Text {
                text: @tr("Import as:");
                vertical-alignment: center;
            }
            ComboBox {
                model: [@tr("an album (a menu to choose the episode)"), @tr("one story per episode")];
                current-index <=> root.mode;
                selected => { root.mode-changed(); }
                horizontal-stretch: 1;
            }
            Button { text: @tr("All"); clicked => { root.select-all(true); } }
            Button { text: @tr("None"); clicked => { root.select-all(false); } }
        }
        if root.rows.length > 0: Rectangle {
            vertical-stretch: 1;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.alternate-background;
            // keyboard: arrows, Page Up/Down, Home/End move the selection,
            // Space checks or unchecks the episode selected
            scope := FocusScope {
                width: 100%;
                height: 100%;
                enabled: root.interactive;
                function go(row: int) {
                    root.selected-row = max(0, min(root.rows.length - 1, row));
                    self.reveal();
                    // again once the list has made the rows now shown: it
                    // corrects its position then
                    reveal-again.running = true;
                }
                // the selected row in view
                function reveal() {
                    if (root.selected-row * root.row-height < -episode-list.content-y) {
                        episode-list.content-y = -root.selected-row * root.row-height;
                    } else if ((root.selected-row + 1) * root.row-height > -episode-list.content-y + episode-list.visible-height) {
                        episode-list.content-y = -((root.selected-row + 1) * root.row-height - episode-list.visible-height);
                    }
                }
                reveal-again := Timer {
                    interval: 1ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        scope.reveal();
                    }
                }
                key-pressed(event) => {
                    if (event.modifiers.alt || event.modifiers.control) {
                        return reject;
                    }
                    if (event.text == Key.UpArrow) {
                        self.go(root.selected-row < 0 ? 0 : root.selected-row - 1);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        self.go(root.selected-row + 1);
                        return accept;
                    }
                    if (event.text == Key.PageUp) {
                        self.go(root.selected-row - 10);
                        return accept;
                    }
                    if (event.text == Key.PageDown) {
                        self.go(root.selected-row + 10);
                        return accept;
                    }
                    if (event.text == Key.Home) {
                        self.go(0);
                        return accept;
                    }
                    if (event.text == Key.End) {
                        self.go(root.rows.length - 1);
                        return accept;
                    }
                    if (event.text == " " && root.selected-row >= 0 && root.selected-row < root.rows.length) {
                        if (!root.rows[root.selected-row].present || root.rows[root.selected-row].removable) {
                            root.toggle(root.rows[root.selected-row].index);
                        }
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    // header
                    Rectangle {
                        height: root.row-height;
                        background: Palette.control-background;
                        HorizontalLayout {
                            padding-left: 6px;
                            // the scrollbar
                            padding-right: 14px;
                            spacing: 6px;
                            SortHeader {
                                text: @tr("On the device");
                                width: root.col-device;
                                sorted: root.sort-column == 3;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(3); }
                            }
                            SortHeader {
                                text: @tr("Title");
                                horizontal-stretch: 1;
                                sorted: root.sort-column == 0;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(0); }
                            }
                            SortHeader {
                                text: @tr("Duration");
                                width: root.col-duration;
                                horizontal-alignment: right;
                                sorted: root.sort-column == 1;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(1); }
                            }
                            SortHeader {
                                text: @tr("Published");
                                width: root.col-date;
                                horizontal-alignment: right;
                                sorted: root.sort-column == 2;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(2); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    episode-list := ListView {
                        for row[i] in root.rows: Rectangle {
                            height: root.row-height;
                            property <bool> enabled: !row.present || row.removable;
                            property <bool> selected: i == root.selected-row;
                            background: selected ? Theme.selection : area.has-hover ? #8882 : transparent;
                            property <color> fg: selected ? #fff : enabled ? Palette.foreground : Theme.hidden-text;
                            // a click selects the row; only its box checks it
                            area := TouchArea {
                                clicked => {
                                    root.selected-row = i;
                                    scope.focus();
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                // the scrollbar
                                padding-right: 14px;
                                spacing: 6px;
                                // checked: on the device, or to import; the
                                // changes to apply named beside
                                HorizontalLayout {
                                    width: root.col-device;
                                    spacing: 4px;
                                    // its state follows the row only: the
                                    // clicks go to the TouchArea over it, that
                                    // checks or unchecks the episode
                                    Rectangle {
                                        width: box.preferred-width;
                                        box := CheckBox {
                                            width: 100%;
                                            checked: row.present ? !row.remove : row.checked;
                                            enabled: enabled;
                                        }
                                        TouchArea {
                                            enabled: enabled;
                                            clicked => {
                                                root.selected-row = i;
                                                scope.focus();
                                                root.toggle(row.index);
                                            }
                                        }
                                    }
                                    Text {
                                        text: row.remove ? @tr("to remove") : row.checked && !row.present ? @tr("to import") : "";
                                        color: selected ? #fff : row.remove ? #d33 : Theme.selection;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: row.title;
                                    color: fg;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: row.duration;
                                    color: fg;
                                    width: root.col-duration;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.date;
                                    color: fg;
                                    width: root.col-date;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        if (root.current >= 0 || root.header != "") && root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
        }
        if root.rows.length > 0: HorizontalLayout {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.count;
                color: Theme.hidden-text;
                vertical-alignment: center;
            }
            Button {
                text: root.remove-count == 0 ? @tr("Import ({})", root.selected-count)
                    : root.selected-count == 0 ? @tr("Remove ({})", root.remove-count)
                    : @tr("Import ({}) and remove ({})", root.selected-count, root.remove-count);
                primary: true;
                enabled: root.can-import && (root.selected-count > 0 || root.remove-count > 0);
                clicked => { root.import(); }
            }
        }
    }
}
