// Main window.

import { LineEdit, ProgressIndicator, Spinner, TextEdit, Palette, VerticalBox } from "std-widgets.slint";
import { Action, StoryRow, LogLine, DialogKind, Theme, IconButton, InfoRow, EpisodeRow, AlbumTrackRow, FollowedRow, PodcastResult, ViewSwitch } from "common.slint";
import { StoryTable } from "story_table.slint";
import { ConfirmRemoveDialog, LoginDialog, NightModeDialog, AboutDialog, DeviceInfoDialog, AddPodcastDialog, UnfollowDialog } from "dialogs.slint";
import { PodcastsView } from "podcasts.slint";
import { AlbumEditor } from "album_editor.slint";
import { LogPanel } from "log_panel.slint";

export { Action, Theme, StoryRow, LogLine, DialogKind, InfoRow, EpisodeRow, AlbumTrackRow, FollowedRow, PodcastResult }

component StatusText inherits Text {
    color: Theme.status-text;
    vertical-alignment: center;
    font-size: 12px;
}

component StatusSeparator inherits Rectangle {
    width: 1px;
    background: Palette.border;
}

export component MainWindow inherits Window {
    in property <string> app-version;
    in property <image> device-icon: @image-url("img/lunii.png");

    // devices
    in property <[string]> devices;
    in-out property <int> device-index: -1;
    in-out property <string> device-value;
    in property <string> device-placeholder;
    callback device-selected(index: int);

    // night mode button
    in property <bool> nm-available;
    in property <bool> nm-active;

    // filter
    in-out property <string> filter;
    callback filter-edited();

    // stories
    in property <[StoryRow]> rows;
    in property <int> current-row: -1;
    in property <bool> show-nm: true;
    in-out property <bool> show-size: false;
    // optional columns of the story list (saved in the settings)
    in-out property <bool> show-duration: true;
    in-out property <bool> show-db: false;
    in-out property <bool> show-uuid: false;
    in-out property <bool> normalize-volume: false;
    in-out property <bool> show-details: true;
    in property <string> list-placeholder;
    in property <bool> drop-hover;
    callback row-pointer(row: int, ctrl: bool, shift: bool, right: bool);
    callback key-nav(delta: int, shift: bool);
    // selected stories dragged before the row `gap` (rows.length: at the end)
    callback rows-dropped(gap: int);
    callback select-all();

    // details panel, beside the list: always there (unless turned off or the
    // window is too narrow), so that the list keeps its size
    in property <bool> details-visible;
    // stories selected: the panel tells when there is none or several
    in property <int> selected-count;
    // room for the panel beside the list: updated by a handler (a binding to
    // the window width would be a layout binding loop)
    property <bool> wide: true;
    // width chosen by dragging the panel edge (saved in the settings), shown
    // narrower when the list would not have enough room
    in-out property <length> details-width: 330px;
    property <length> details-min-width: 240px;
    property <length> details-max-width: max(root.details-min-width, root.width - 420px);
    property <length> details-shown-width: 330px;
    changed width => {
        root.wide = root.width >= 760px;
        root.details-shown-width = clamp(root.details-width, root.details-min-width, root.details-max-width);
    }
    changed details-width => {
        root.details-shown-width = clamp(root.details-width, root.details-min-width, root.details-max-width);
    }
    // the panel edge released: the width is saved
    callback details-width-changed();
    in property <image> picture;
    in property <bool> has-picture;
    in property <string> description;
    in property <bool> details-dimmed;
    // track list of the selected album
    in property <bool> album-visible;
    in property <bool> album-editable;
    // album of a podcast: episodes only moved (added, removed in Podcasts)
    in property <bool> album-podcast;
    in property <[AlbumTrackRow]> album-rows;
    in-out property <int> album-current: -1;
    in property <bool> album-modified;
    callback album-move(delta: int);
    // track `from` dragged before the row `gap`
    callback album-drop(from: int, gap: int);
    callback album-remove();
    callback album-add-files();
    callback album-apply();
    callback album-revert();

    // progress
    in property <bool> busy;
    // devices being searched or opened (in the background)
    in property <bool> scanning;
    in property <string> total-text;
    in property <float> total-progress;
    in property <bool> total-visible;
    // remaining time of an import
    in property <string> eta-text;
    in property <string> story-text;
    in property <float> story-progress;
    in property <bool> story-visible;
    in property <float> file-progress;
    in property <bool> file-visible;
    in property <bool> abort-visible;
    callback abort();

    // status bar
    in property <string> status;
    in property <string> snu;
    in property <string> hw-version;
    in property <string> free-space;
    in property <bool> low-space;
    in property <string> story-count;
    callback device-info-clicked();
    // device information dialog
    in property <[InfoRow]> device-info-rows;
    in property <string> device-details;
    callback device-info-copy();
    callback device-open-folder();

    // log panel
    in property <[LogLine]> log-lines;
    in-out property <bool> log-visible;
    // height chosen by dragging the panel edge
    in-out property <length> log-height: 170px;
    // what the rest of the window needs (bars, list, progress): the panel is
    // shown lower when there is not enough room, and gets back to its height
    // once there is
    // the track list of an album in the details panel needs more than the
    // story list alone
    property <length> details-height: root.view == 0 && root.details-visible && root.album-visible ? 120px : 0px;
    // progress bars of a running task
    property <length> progress-height: root.total-visible || root.story-visible ? 40px : 0px;
    // smallest panel: its toolbar, two lines and the log file path
    property <length> log-min-height: 110px;
    property <length> log-max-height: max(root.log-min-height, root.height - 290px - root.details-height - root.progress-height);
    // height shown: updated by these handlers (a binding to the window height
    // would be a layout binding loop)
    property <length> log-shown-height: 170px;
    changed log-max-height => {
        root.log-shown-height = clamp(root.log-height, root.log-min-height, root.log-max-height);
    }
    changed log-height => {
        root.log-shown-height = clamp(root.log-height, root.log-min-height, root.log-max-height);
    }
    in-out property <int> log-level-index: 2;
    in-out property <string> log-filter;
    in property <string> log-file-path;
    // highest level logged while the panel was hidden (0: nothing, 2: warning, 3: error)
    in property <int> log-alert;
    // incremented to scroll the panel to the last line
    in property <int> log-scroll-token;
    callback log-filter-changed();
    callback log-clear();
    callback log-copy();
    callback log-open-folder();

    // menu states
    in property <bool> device-ready;
    in property <bool> is-flam;
    in property <bool> can-import;
    in property <bool> has-selection;
    in property <bool> can-export;
    in property <bool> can-export-all;
    in property <bool> can-add-to-album;
    // the album selected is not the one of a podcast: MP3 files can be added
    in property <bool> can-add-mp3;
    in property <bool> update-available;
    in property <string> latest-version;
    // every menu entry goes through this callback
    callback action(action: Action);

    // dialogs
    in-out property <DialogKind> dialog: DialogKind.none;
    in property <string> confirm-message;
    in-out property <string> login-email;
    in-out property <string> login-password;
    in-out property <bool> nm-enabled;
    in-out property <bool> nm-limit;
    in-out property <bool> nm-autoplay;
    in-out property <int> nm-max-stories: 3;
    in-out property <bool> nm-turnoff;
    // 0: stories, 1: podcasts
    in-out property <int> view;
    callback view-changed();
    // Podcasts view
    in property <[FollowedRow]> podcast-followed;
    in-out property <int> podcast-current: -1;
    in property <bool> podcast-loading;
    in property <string> podcast-header;
    in property <[EpisodeRow]> podcast-rows;
    in property <int> podcast-selected-count;
    in property <int> podcast-remove-count;
    // 0: title, 1: duration, 2: date, 3: on the device
    in-out property <int> podcast-sort-column: 2;
    in-out property <bool> podcast-sort-ascending: false;
    in-out property <string> podcast-filter;
    in-out property <int> podcast-mode;
    callback podcast-add();
    callback podcast-select(index: int);
    callback podcast-refresh();
    callback podcast-unfollow();
    // the podcast unfollowed, its album or stories removed from the device or not
    callback podcast-unfollow-accepted(remove: bool);
    callback podcast-mode-changed();
    callback podcast-toggle(index: int);
    callback podcast-select-all(all: bool);
    callback podcast-filter-edited();
    callback podcast-accepted();
    callback podcast-sort-changed();
    // "Add a podcast" dialog
    in-out property <string> podcast-add-query;
    in property <[PodcastResult]> podcast-add-results;
    in property <int> podcast-add-selected: -1;
    in property <bool> podcast-add-working;
    in property <string> podcast-add-message;
    in property <bool> podcast-add-error;
    in property <bool> podcast-add-can-follow;
    callback podcast-add-submit();
    callback podcast-add-choose(index: int);
    callback podcast-add-follow();

    callback confirm-remove-accepted();
    callback login-accepted();
    callback night-mode-accepted();
    callback open-url(url: string);

    title: "Lunii " + root.app-version;
    icon: root.device-icon;
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 500px;
    min-height: 400px;

    public function ensure-visible(row: int) {
        table.ensure-visible(row);
    }

    // a dialog is open: the menus (and their shortcuts) are disabled
    property <bool> modal: root.dialog != DialogKind.none;
    property <bool> idle: !root.busy && !root.scanning && !root.modal;
    property <bool> story-actions: root.device-ready && root.idle;
    // after the change, whatever toggled it (menu, settings)
    changed show-size => { root.action(Action.show-size); }
    changed show-duration => { root.action(Action.columns); }
    changed show-db => { root.action(Action.columns); }
    changed show-uuid => { root.action(Action.columns); }
    // the selection is only acted on in the stories view
    property <bool> selection-actions: root.story-actions && root.has-selection && root.view == 0;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("Import STUdio DB"); enabled: root.idle; activated => { root.action(Action.import-db); } }
            MenuItem { title: @tr("Refresh official DB"); enabled: root.idle; activated => { root.action(Action.refresh-db); } }
            MenuSeparator { }
            MenuItem { enabled: !root.modal; title: @tr("Exit"); shortcut: @keys(Control + Q); activated => { root.action(Action.exit); } }
        }
        Menu {
            title: @tr("Device");
            // the devices found: the one opened checked
            for label[i] in root.devices: MenuItem {
                title: label;
                checkable: true;
                checked: i == root.device-index;
                enabled: !root.busy && !root.scanning && !root.modal;
                activated => {
                    root.device-index = i;
                    root.device-value = label;
                    root.device-selected(i);
                }
            }
            if root.devices.length == 0: MenuItem {
                title: root.device-placeholder;
                enabled: false;
            }
            MenuSeparator { }
            MenuItem { title: @tr("Refresh connected devices"); shortcut: @keys(F5); enabled: root.idle && !root.scanning; activated => { root.action(Action.refresh-devices); } }
            MenuItem { title: @tr("Device information"); enabled: root.device-ready && !root.modal; activated => { root.action(Action.device-info); } }
            MenuSeparator { }
            Menu {
                title: @tr("Lost stories");
                enabled: root.story-actions;
                MenuItem { enabled: !root.modal; title: @tr("Find"); activated => { root.action(Action.find-lost); } }
                MenuItem { enabled: !root.modal; title: @tr("Recover"); activated => { root.action(Action.recover-lost); } }
                MenuItem { enabled: !root.modal; title: @tr("Remove"); activated => { root.action(Action.remove-lost); } }
            }
        }
        Menu {
            title: @tr("Stories");
            MenuItem { title: @tr("Move Top"); shortcut: @keys(Control + UpArrow); enabled: root.selection-actions; activated => { root.action(Action.move-top); } }
            MenuItem { title: @tr("Move Up"); shortcut: @keys(Alt + UpArrow); enabled: root.selection-actions; activated => { root.action(Action.move-up); } }
            MenuItem { title: @tr("Move Down"); shortcut: @keys(Alt + DownArrow); enabled: root.selection-actions; activated => { root.action(Action.move-down); } }
            MenuItem { title: @tr("Move Bottom"); shortcut: @keys(Control + DownArrow); enabled: root.selection-actions; activated => { root.action(Action.move-bottom); } }
            MenuSeparator { }
            MenuItem { title: @tr("Hide / Show"); shortcut: @keys(Control + H); enabled: root.selection-actions; activated => { root.action(Action.hide); } }
            MenuItem { title: @tr("Force Night Mode"); shortcut: @keys(Control + N); enabled: root.selection-actions && !root.is-flam; activated => { root.action(Action.night-mode); } }
            MenuSeparator { }
            MenuItem { title: @tr("Import"); shortcut: @keys(Control + I); enabled: root.story-actions && root.can-import; activated => { root.action(Action.import); } }
            MenuItem { title: @tr("Import MP3 album"); shortcut: @keys(Control + Shift + I); enabled: root.story-actions && root.can-import; activated => { root.action(Action.import-album); } }
            MenuItem { title: @tr("Add MP3 to album"); enabled: root.story-actions && root.can-add-mp3; activated => { root.action(Action.add-to-album); } }
            MenuItem { title: @tr("Edit the album"); enabled: root.story-actions && root.can-add-to-album; activated => { root.action(Action.edit-album); } }
            MenuItem { title: @tr("Import a podcast"); shortcut: @keys(Control + P); enabled: !root.modal; activated => { root.action(Action.import-podcast); } }
            MenuItem { title: @tr("Export"); shortcut: @keys(Control + S); enabled: root.selection-actions && root.can-export; activated => { root.action(Action.export); } }
            MenuItem { title: @tr("Export All"); shortcut: @keys(Control + Shift + S); enabled: root.story-actions && root.can-export-all; activated => { root.action(Action.export-all); } }
            MenuItem { title: @tr("Remove"); shortcut: @keys(Delete); enabled: root.selection-actions; activated => { root.action(Action.remove); } }
        }
        Menu {
            title: @tr("Tools");
            MenuItem { enabled: !root.modal; title: @tr("Show size"); checkable: true; checked <=> root.show-size; }
            MenuItem { enabled: !root.modal; title: @tr("Show duration"); checkable: true; checked <=> root.show-duration; }
            MenuItem { enabled: !root.modal; title: @tr("Show database (O / T)"); checkable: true; checked <=> root.show-db; }
            MenuItem { enabled: !root.modal; title: @tr("Show UUID"); checkable: true; checked <=> root.show-uuid; }
            MenuItem { enabled: !root.modal; title: @tr("Show story details"); checkable: true; checked <=> root.show-details; activated => { root.action(Action.show-details); } }
            MenuSeparator { }
            MenuItem { title: @tr("Normalize volume (albums, podcasts)"); checkable: true; checked <=> root.normalize-volume; enabled: !root.modal; activated => { root.action(Action.normalize-volume); } }
            MenuSeparator { }
            Menu {
                title: @tr("Advanced");
                MenuItem { enabled: !root.modal; title: @tr("Show Log"); shortcut: @keys(Control + L); checkable: true; checked: root.log-visible; activated => { root.action(Action.show-log); } }
                MenuItem { title: @tr("Get FW Update"); enabled: root.story-actions; activated => { root.action(Action.get-firmware); } }
            }
        }
        Menu {
            title: root.update-available ? @tr("[ Help ]") : @tr("Help");
            if root.update-available: MenuItem { enabled: !root.modal; title: @tr("Update to {}", root.latest-version); activated => { root.action(Action.update); } }
            MenuItem { enabled: !root.modal; title: @tr("About"); shortcut: @keys(F1); activated => { root.action(Action.about); } }
        }
        if root.update-available: Menu {
            title: @tr("Update is available");
            MenuItem { enabled: !root.modal; title: @tr("Update to {}", root.latest-version); activated => { root.action(Action.update); } }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        // ---------------------------------------------------------------- top bar
        HorizontalLayout {
            spacing: 4px;
            // devices being searched / opened: wait
            if root.scanning: Rectangle {
                width: 30px;
                Spinner {
                    indeterminate: true;
                    width: 22px;
                    height: 22px;
                }
            }
            IconButton {
                icon: root.nm-active ? @image-url("../../res/mode_night.png") : @image-url("../../res/mode_day.png");
                icon-size: 22px;
                icon-width: 47px;
                enabled: root.nm-available && !root.busy;
                clicked => { root.action(Action.night-mode-settings); }
            }
            Rectangle { min-width: 8px; max-width: 40px; horizontal-stretch: 0.2; }
            VerticalLayout {
                alignment: center;
                ViewSwitch {
                    first: @tr("Stories");
                    second: @tr("Podcasts");
                    current <=> root.view;
                    changed-view => { root.view-changed(); }
                }
            }
            Rectangle { min-width: 8px; max-width: 40px; horizontal-stretch: 0.2; }
            if root.view == 0: LineEdit {
                text <=> root.filter;
                placeholder-text: @tr("(Story Name or UUID filter text)");
                edited => { root.filter-edited(); }
                horizontal-stretch: 1;
            }
            if root.view != 0: Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: @image-url("../../res/refresh_db.png");
                enabled: !root.busy;
                clicked => { root.action(Action.refresh-db); }
            }
        }

        // ---------------------------------------------------------------- views
        Rectangle {
            vertical-stretch: 1;
            min-height: 200px;
            HorizontalLayout {
                visible: root.view == 0;
                width: parent.width;
                height: parent.height;
                spacing: 2px;
                // ---------------------------------------------------------------- stories
                story-menu := ContextMenuArea {
                    horizontal-stretch: 1;
                    enabled: root.story-actions;
                    Menu {
                        MenuItem { title: @tr("Move Top"); enabled: root.selection-actions; activated => { root.action(Action.move-top); } }
                        MenuItem { title: @tr("Move Up"); enabled: root.selection-actions; activated => { root.action(Action.move-up); } }
                        MenuItem { title: @tr("Move Down"); enabled: root.selection-actions; activated => { root.action(Action.move-down); } }
                        MenuItem { title: @tr("Move Bottom"); enabled: root.selection-actions; activated => { root.action(Action.move-bottom); } }
                        MenuSeparator { }
                        MenuItem { title: @tr("Hide / Show"); enabled: root.selection-actions; activated => { root.action(Action.hide); } }
                        MenuItem { title: @tr("Force Night Mode"); enabled: root.selection-actions && !root.is-flam; activated => { root.action(Action.night-mode); } }
                        MenuSeparator { }
                        MenuItem { title: @tr("Import"); enabled: root.can-import; activated => { root.action(Action.import); } }
                        MenuItem { title: @tr("Import MP3 album"); enabled: root.can-import; activated => { root.action(Action.import-album); } }
                        MenuItem { title: @tr("Add MP3 to album"); enabled: root.can-add-mp3; activated => { root.action(Action.add-to-album); } }
                        MenuItem { title: @tr("Edit the album"); enabled: root.can-add-to-album; activated => { root.action(Action.edit-album); } }
                        MenuItem { title: @tr("Export"); enabled: root.selection-actions && root.can-export; activated => { root.action(Action.export); } }
                        MenuItem { title: @tr("Export All"); enabled: root.can-export-all; activated => { root.action(Action.export-all); } }
                        MenuItem { title: @tr("Remove"); enabled: root.selection-actions; activated => { root.action(Action.remove); } }
                    }

                    table := StoryTable {
                        min-height: 150px;
                        vertical-stretch: 1;
                        rows: root.rows;
                        current-row: root.current-row;
                        show-nm: root.show-nm;
                        show-size: root.show-size;
                        show-duration: root.show-duration;
                        show-db: root.show-db;
                        show-uuid: root.show-uuid;
                        interactive: !root.busy;
                        drop-hover: root.drop-hover;
                        placeholder: root.list-placeholder;
                        row-pointer(row, ctrl, shift, right) => { root.row-pointer(row, ctrl, shift, right); }
                        // the table fills the ContextMenuArea: same coordinates
                        context-menu(position) => {
                            if (root.story-actions) {
                                story-menu.show(position);
                            }
                        }
                        key-nav(delta, shift) => { root.key-nav(delta, shift); }
                        select-all => { root.select-all(); }
                        can-move: root.selection-actions;
                        rows-dropped(gap) => { root.rows-dropped(gap); }
                    }
                }

                // ---------------------------------------------------------------- details
                // drag handle resizing the panel
                if root.view == 0 && root.show-details && root.device-ready && root.wide: Rectangle {
                    width: 6px;
                    Rectangle {
                        width: 2px;
                        height: 40px;
                        border-radius: 1px;
                        background: details-handle.has-hover || details-handle.pressed ? Palette.foreground : Palette.border;
                    }
                    details-handle := TouchArea {
                        mouse-cursor: ew-resize;
                        moved => {
                            root.details-width = clamp(root.details-shown-width - (self.mouse-x - self.pressed-x), root.details-min-width, root.details-max-width);
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.up {
                                root.details-width-changed();
                            }
                        }
                    }
                }
                if root.view == 0 && root.show-details && root.device-ready && root.wide: VerticalLayout {
                    width: root.details-shown-width;
                    spacing: 6px;
                    opacity: root.details-visible && root.details-dimmed ? 0.5 : 1;
                    if root.details-visible && root.has-picture: Image {
                        source: root.picture;
                        // smaller beside the tracks of an album
                        height: root.album-visible ? 120px : 200px;
                        image-fit: contain;
                    }
                    if root.details-visible && !root.album-visible: TextEdit {
                        text: root.description;
                        read-only: true;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                    if root.details-visible && root.album-visible && root.description != "": Text {
                        text: root.description;
                        wrap: word-wrap;
                        max-height: 54px;
                        overflow: elide;
                    }
                    if root.details-visible && root.album-visible: AlbumEditor {
                        vertical-stretch: 1;
                        rows: root.album-rows;
                        current <=> root.album-current;
                        modified: root.album-modified;
                        editable: root.album-editable;
                        podcast: root.album-podcast;
                        interactive: !root.busy;
                        move(delta) => { root.album-move(delta); }
                        dropped(from, gap) => { root.album-drop(from, gap); }
                        remove => { root.album-remove(); }
                        add-files => { root.album-add-files(); }
                        apply => { root.album-apply(); }
                        revert => { root.album-revert(); }
                    }
                    // nothing to show: no story or several selected, or details
                    // being read
                    if !root.details-visible: Rectangle {
                        vertical-stretch: 1;
                        border-width: 1px;
                        border-radius: 4px;
                        border-color: Palette.border;
                        Text {
                            width: parent.width - 32px;
                            text: root.selected-count == 0 ? @tr("Select a story to see its details.")
                                : root.selected-count > 1 ? @tr("{} stories selected", root.selected-count) : "";
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            color: Theme.hidden-text;
                        }
                    }
                }
            }
            if root.view == 1: PodcastsView {
                width: parent.width;
                height: parent.height;
                followed: root.podcast-followed;
                current <=> root.podcast-current;
                header: root.podcast-header;
                loading: root.podcast-loading;
                rows: root.podcast-rows;
                selected-count: root.podcast-selected-count;
                remove-count: root.podcast-remove-count;
                sort-column <=> root.podcast-sort-column;
                sort-ascending <=> root.podcast-sort-ascending;
                filter <=> root.podcast-filter;
                mode <=> root.podcast-mode;
                can-import: root.story-actions && root.can-import;
                interactive: !root.busy;
                add => { root.podcast-add(); }
                select(index) => { root.podcast-select(index); }
                refresh => { root.podcast-refresh(); }
                unfollow => { root.podcast-unfollow(); }
                mode-changed => { root.podcast-mode-changed(); }
                toggle(index) => { root.podcast-toggle(index); }
                select-all(all) => { root.podcast-select-all(all); }
                filter-edited => { root.podcast-filter-edited(); }
                import => { root.podcast-accepted(); }
                sort-changed => { root.podcast-sort-changed(); }
            }
        }

        // ---------------------------------------------------------------- progress
        if root.total-visible || root.story-visible: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                spacing: 4px;
                if root.total-visible: HorizontalLayout {
                    spacing: 6px;
                    Text { text: root.total-text; min-width: 90px; horizontal-alignment: center; vertical-alignment: center; }
                    ProgressIndicator { progress: root.total-progress; height: 10px; y: (parent.height - self.height) / 2; }
                    if root.eta-text != "": Text {
                        text: root.eta-text;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.status-text;
                    }
                }
                if root.story-visible: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.story-text;
                        min-width: 90px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-family: Theme.mono-font;
                        font-size: 12px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        ProgressIndicator { progress: root.story-progress; height: 10px; }
                        if root.file-visible: ProgressIndicator { progress: root.file-progress; height: 6px; }
                    }
                }
            }
            if root.abort-visible: IconButton {
                icon: @image-url("../../res/remove.png");
                icon-size: 24px;
                clicked => { root.abort(); }
            }
        }

        // ---------------------------------------------------------------- log
        if root.log-visible: VerticalLayout {
            spacing: 0px;
            // drag handle resizing the panel
            Rectangle {
                height: 6px;
                Rectangle {
                    width: 40px;
                    height: 2px;
                    border-radius: 1px;
                    background: handle.has-hover || handle.pressed ? Palette.foreground : Palette.border;
                }
                handle := TouchArea {
                    mouse-cursor: ns-resize;
                    moved => {
                        root.log-height = clamp(root.log-shown-height - (self.mouse-y - self.pressed-y), root.log-min-height, root.log-max-height);
                    }
                }
            }
            panel := LogPanel {
                height: root.log-shown-height;
                lines: root.log-lines;
                level-index <=> root.log-level-index;
                filter <=> root.log-filter;
                file-path: root.log-file-path;
                filter-changed => { root.log-filter-changed(); }
                clear-clicked => { root.log-clear(); }
                copy-clicked => { root.log-copy(); }
                open-folder-clicked => { root.log-open-folder(); }
                close-clicked => { root.log-visible = false; }
                init => { self.scroll-to-bottom(); }
            }
            // a property change, as the conditional panel can't be called from outside
            property <int> scroll-token: root.log-scroll-token;
            changed scroll-token => { panel.scroll-to-bottom(); }
        }

        // ---------------------------------------------------------------- status bar
        HorizontalLayout {
            height: 20px;
            spacing: 8px;
            Text {
                text: root.status;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                font-size: 12px;
            }
            if root.snu != "": Rectangle {
                HorizontalLayout {
                    spacing: 8px;
                    StatusSeparator { }
                    StatusText { text: "SNU: " + root.snu; }
                    StatusSeparator { }
                    StatusText { text: root.hw-version; }
                    StatusSeparator { }
                    StatusText {
                        text: @tr("Free :") + " " + root.free-space;
                        color: root.low-space ? Theme.warning : Theme.status-text;
                    }
                    if root.story-count != "": StatusSeparator { }
                    if root.story-count != "": StatusText { text: root.story-count; }
                }
                // click: device information dialog
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.device-info-clicked(); }
                }
            }
            StatusSeparator { }
            // log panel toggle, with a dot for warnings / errors not seen yet
            Rectangle {
                width: 20px;
                Image {
                    source: @image-url("../../res/debug_log.png");
                    width: 16px;
                    height: 16px;
                    opacity: root.log-visible || log-toggle.has-hover ? 1 : 0.6;
                }
                if root.log-alert >= 2: Rectangle {
                    x: parent.width - 7px;
                    y: 1px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.log-alert >= 3 ? Theme.warning : #c77700;
                }
                log-toggle := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action(Action.show-log); }
                }
            }
        }
    }

    // -------------------------------------------------------------------- dialogs
    if root.dialog == DialogKind.confirm-remove: ConfirmRemoveDialog {
        width: root.width;
        height: root.height;
        message: root.confirm-message;
        close => { root.dialog = DialogKind.none; }
        accepted => { root.dialog = DialogKind.none; root.confirm-remove-accepted(); }
    }
    if root.dialog == DialogKind.unfollow-podcast: UnfollowDialog {
        width: root.width;
        height: root.height;
        message: root.confirm-message;
        close => { root.dialog = DialogKind.none; }
        accepted(remove) => { root.dialog = DialogKind.none; root.podcast-unfollow-accepted(remove); }
    }
    if root.dialog == DialogKind.add-podcast: AddPodcastDialog {
        width: root.width;
        height: root.height;
        query <=> root.podcast-add-query;
        results: root.podcast-add-results;
        selected: root.podcast-add-selected;
        working: root.podcast-add-working;
        message: root.podcast-add-message;
        message-error: root.podcast-add-error;
        can-follow: root.podcast-add-can-follow;
        close => { root.dialog = DialogKind.none; }
        submit => { root.podcast-add-submit(); }
        choose(index) => { root.podcast-add-choose(index); }
        follow => { root.podcast-add-follow(); }
    }
    if root.dialog == DialogKind.login: LoginDialog {
        width: root.width;
        height: root.height;
        email <=> root.login-email;
        password <=> root.login-password;
        close => { root.dialog = DialogKind.none; }
        accepted => { root.dialog = DialogKind.none; root.login-accepted(); }
    }
    if root.dialog == DialogKind.night-mode: NightModeDialog {
        width: root.width;
        height: root.height;
        nm-enabled <=> root.nm-enabled;
        nm-limit <=> root.nm-limit;
        nm-autoplay <=> root.nm-autoplay;
        nm-max-stories <=> root.nm-max-stories;
        nm-turnoff <=> root.nm-turnoff;
        close => { root.dialog = DialogKind.none; }
        accepted => { root.dialog = DialogKind.none; root.night-mode-accepted(); }
        open-guide => { root.open-url(@tr("https://support.lunii.com/hc/en-gb/categories/4404826574353-The-Night-Mode")); }
    }
    if root.dialog == DialogKind.about: AboutDialog {
        width: root.width;
        height: root.height;
        version: root.app-version;
        close => { root.dialog = DialogKind.none; }
        open-url(url) => { root.open-url(url); }
    }
    if root.dialog == DialogKind.device-info: DeviceInfoDialog {
        width: root.width;
        height: root.height;
        rows: root.device-info-rows;
        details: root.device-details;
        close => { root.dialog = DialogKind.none; }
        copy => { root.device-info-copy(); }
        open-folder => { root.device-open-folder(); }
    }
}
