// Story list.

import { ListView, Palette } from "std-widgets.slint";
import { StoryRow, Theme } from "common.slint";

component HeaderCell inherits Text {
    vertical-alignment: center;
    font-weight: 600;
    overflow: elide;
}

export component StoryTable inherits Rectangle {
    in property <[StoryRow]> rows;
    in property <bool> show-nm: true;
    in property <bool> show-size: false;
    in property <bool> show-duration: true;
    in property <bool> show-db: false;
    in property <bool> show-uuid: false;
    in property <bool> interactive: true;
    in property <int> current-row: -1;
    in property <bool> drop-hover: false;
    // text shown when there is no story
    in property <string> placeholder;
    // the selected stories can be dragged to another place of the list
    in property <bool> can-move: false;

    // left click (ctrl, shift) or right click on a row
    callback row-pointer(row: int, ctrl: bool, shift: bool, right: bool);
    // right click on a row, at `position` in the table: its context menu (the
    // rows take the right button, a ContextMenuArea around never gets it)
    callback context-menu(position: Point);
    // arrow keys / page keys
    callback key-nav(delta: int, shift: bool);
    callback select-all();
    // selected stories dropped before the row `gap` (rows.length: after the last)
    callback rows-dropped(gap: int);

    // stories being dragged: their drop point (a row, or rows.length), -1 otherwise
    property <int> drag-gap: -1;

    property <length> row-height: 26px;
    property <length> col-flag: 30px;
    property <length> col-uuid: 300px;
    property <length> col-size: 80px;
    property <length> col-duration: 70px;

    border-width: 1px;
    border-color: root.drop-hover ? Theme.selection : Palette.border;
    border-radius: 2px;
    background: Palette.alternate-background;
    opacity: root.interactive ? 1 : 0.6;

    public function ensure-visible(row: int) {
        if (row < 0) {
            return;
        }
        if (row * root.row-height < -list.content-y) {
            list.content-y = -row * root.row-height;
        } else if ((row + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((row + 1) * root.row-height - list.visible-height);
        }
    }

    focus-scope := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if (event.modifiers.alt || (event.modifiers.control && event.text != "a")) {
                return reject;
            }
            if (event.text == Key.UpArrow) {
                root.key-nav(-1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.key-nav(1, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageUp) {
                root.key-nav(-10, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.PageDown) {
                root.key-nav(10, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.Home) {
                root.key-nav(-100000, event.modifiers.shift);
                return accept;
            }
            if (event.text == Key.End) {
                root.key-nav(100000, event.modifiers.shift);
                return accept;
            }
            if (event.text == "a" && event.modifiers.control) {
                root.select-all();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // header
            Rectangle {
                height: root.row-height;
                background: Palette.control-background;
                HorizontalLayout {
                    padding-left: 6px;
                    // the scrollbar
                    padding-right: 14px;
                    spacing: 4px;
                    HeaderCell { text: @tr("Story Name"); horizontal-stretch: 1; }
                    if root.show-nm: HeaderCell { text: @tr("NM"); width: root.col-flag; horizontal-alignment: center; }
                    if root.show-db: HeaderCell { text: @tr("DB"); width: root.col-flag; horizontal-alignment: center; }
                    if root.show-uuid: HeaderCell { text: "UUID"; width: root.col-uuid; }
                    if root.show-duration: HeaderCell { text: @tr("Duration"); width: root.col-duration; horizontal-alignment: right; }
                    if root.show-size: HeaderCell { text: @tr("Size"); width: root.col-size; horizontal-alignment: right; }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
            }

            list := ListView {
                for row[index] in root.rows: Rectangle {
                    height: root.row-height;
                    background: row.selected ? Theme.selection : (index == root.current-row && focus-scope.has-focus ? #8883 : transparent);
                    property <color> fg: row.selected ? white : (row.hidden ? Theme.hidden-text : Palette.foreground);

                    HorizontalLayout {
                        padding-left: 6px;
                        // the scrollbar
                        padding-right: 14px;
                        spacing: 4px;
                        Text {
                            text: row.name;
                            color: fg;
                            font-italic: row.hidden;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.show-nm: Rectangle {
                            width: root.col-flag;
                            if row.night-mode: Text {
                                text: "☾";
                                color: fg;
                                font-size: 16px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if root.show-db: Text {
                            text: row.official ? "O" : "T";
                            color: fg;
                            width: root.col-flag;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if root.show-uuid: Text {
                            text: row.uuid;
                            color: fg;
                            width: root.col-uuid;
                            font-family: Theme.mono-font;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.show-duration: Text {
                            text: row.duration;
                            color: fg;
                            width: root.col-duration;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        if root.show-size: Text {
                            text: row.size;
                            color: fg;
                            width: root.col-size;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        enabled: root.interactive;
                        // pressed on a selected row: the selection may be
                        // dragged; only this row selected on release otherwise
                        property <bool> pending: false;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                focus-scope.focus();
                                root.drag-gap = -1;
                                if (event.button == PointerEventButton.left) {
                                    self.pending = row.selected && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.shift;
                                    if (!self.pending) {
                                        root.row-pointer(index, event.modifiers.control || event.modifiers.meta, event.modifiers.shift, false);
                                    }
                                } else if (event.button == PointerEventButton.right) {
                                    root.row-pointer(index, false, false, true);
                                    root.context-menu({
                                        x: self.absolute-position.x - root.absolute-position.x + self.mouse-x,
                                        y: self.absolute-position.y - root.absolute-position.y + self.mouse-y,
                                    });
                                }
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                if (root.drag-gap >= 0) {
                                    let gap = root.drag-gap;
                                    root.drag-gap = -1;
                                    root.rows-dropped(gap);
                                } else if (self.pending) {
                                    root.row-pointer(index, false, false, false);
                                }
                                self.pending = false;
                            }
                            if (event.kind == PointerEventKind.cancel) {
                                root.drag-gap = -1;
                                self.pending = false;
                            }
                        }
                        moved => {
                            if (!self.pressed || !root.can-move || !row.selected) {
                                return;
                            }
                            if (root.drag-gap < 0 && abs(self.mouse-y - self.pressed-y) < 6px) {
                                return;
                            }
                            // between the rows, nearest the pointer
                            root.drag-gap = max(0, min(root.rows.length, index + round(self.mouse-y / root.row-height)));
                            // near an edge: the list scrolls
                            let y = index * root.row-height + list.content-y + self.mouse-y;
                            if (y < root.row-height) {
                                list.content-y = min(0px, list.content-y + root.row-height / 2);
                            } else if (y > list.visible-height - root.row-height) {
                                list.content-y = max(min(0px, list.visible-height - list.content-height), list.content-y - root.row-height / 2);
                            }
                        }
                    }
                }
            }
        }
    }

    // drop point of the stories dragged
    if root.drag-gap >= 0: Rectangle {
        x: 4px;
        width: parent.width - 22px;
        height: 2px;
        y: max(root.row-height, min(parent.height - 2px, root.row-height + root.drag-gap * root.row-height + list.content-y - 1px));
        background: Theme.selection;
    }

    if root.rows.length == 0: Text {
        y: root.row-height;
        height: parent.height - root.row-height;
        width: parent.width;
        text: root.placeholder;
        color: Theme.hidden-text;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}
