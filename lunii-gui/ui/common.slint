// Shared types and small widgets.

import { Palette } from "std-widgets.slint";

export struct StoryRow {
    name: string,
    uuid: string,
    size: string,
    night-mode: bool,
    official: bool,
    hidden: bool,
    selected: bool,
}

export struct LogLine {
    text: string,
    // 0: debug, 1: info, 2: warning, 3: error
    level: int,
}

/// Menu entries and shortcuts, handled by `App::action`.
export enum Action {
    about,
    add-to-album,
    edit-album,
    exit,
    export,
    export-all,
    ffmpeg,
    find-lost,
    get-firmware,
    hide,
    import,
    import-album,
    import-db,
    import-podcast,
    move-bottom,
    move-down,
    move-top,
    move-up,
    night-mode,
    night-mode-settings,
    normalize-volume,
    open-device,
    recover-lost,
    refresh-db,
    refresh-devices,
    remove,
    remove-lost,
    show-details,
    show-log,
    show-size,
    update,
}

export enum DialogKind {
    none,
    confirm-remove,
    login,
    night-mode,
    about,
}

/// A track in the album dialog.
export struct AlbumTrackRow {
    // "3." (empty for a chapter header)
    number: string,
    title: string,
    // not on the device yet
    new: bool,
    // sub-folder title, before its tracks
    header: bool,
}

/// A followed podcast in the Podcasts view.
export struct FollowedRow {
    title: string,
    // new episodes, or the number of episodes
    info: string,
    // new episodes to import in its album on the device
    news: bool,
}

/// An episode in the Podcasts view.
export struct EpisodeRow {
    // index in the podcast episodes
    index: int,
    title: string,
    // date, duration
    info: string,
    checked: bool,
    // already in the album on the device
    present: bool,
}

export global Theme {
    out property <color> hidden-text: #808080;
    out property <color> warning: #d32f2f;
    out property <color> selection: #3584e4;
    out property <color> status-text: #808080;
    in property <string> mono-font: "monospace";
}

/// Flat button showing an icon (refresh, DB...).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 22px;
    in property <length> icon-width: self.icon-size;
    in property <bool> enabled: true;
    callback clicked();

    width: self.icon-width + 8px;
    height: self.icon-size + 8px;
    border-radius: 4px;
    background: area.has-hover && root.enabled ? #8882 : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Image {
        source: root.icon;
        width: root.icon-width;
        height: root.icon-size;
        image-fit: contain;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Clickable text link.
export component Link inherits Text {
    callback clicked();
    color: #3584e4;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Two buttons switching between two views (Stories / Podcasts).
export component ViewSwitch inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in-out property <int> current;
    callback changed-view();

    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;
    clip: true;

    HorizontalLayout {
        for label[i] in [root.first, root.second]: Rectangle {
            background: i == root.current ? Theme.selection : area.has-hover ? #8882 : transparent;
            Text {
                text: label;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: i == root.current ? #fff : Palette.foreground;
            }
            min-width: self.preferred-width;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text { text: label; opacity: 0; }
            }
            area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.current != i) {
                        root.current = i;
                        root.changed-view();
                    }
                }
            }
        }
    }
}
