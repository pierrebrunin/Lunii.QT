// Modal dialogs, displayed as overlays inside the main window.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, SpinBox, Spinner, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Link, Theme, InfoRow, PodcastResult } from "common.slint";

/// Dimmed background + centered panel with a title band. Clicking outside
/// does nothing (modal); Escape or the cross closes it. The main window
/// disables its menus while a dialog is open.
export component Overlay inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 420px;
    callback close();

    background: #000a;
    TouchArea { }   // swallow clicks

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        Rectangle {
            width: root.panel-width;
            height: min(panel-layout.preferred-height, root.height - 40px);
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.accent-background;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000c;
            clip: true;

            panel-layout := VerticalLayout {
                Rectangle {
                    height: 40px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        Text {
                            text: root.title;
                            font-size: 15px;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: close-area.has-hover ? #8884 : transparent;
                                Text {
                                    text: "✕";
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                close-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.close(); }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                }
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    @children
                }
            }
        }
    }
}

export component ConfirmRemoveDialog inherits Overlay {
    in property <string> message;
    callback accepted();

    title: @tr("Delete stories");

    Text {
        text: root.message;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button { text: "OK"; primary: true; clicked => { root.accepted(); } }
    }
}

// "Unfollow" of a podcast on the device: its album or stories removed too, or
// kept.
export component UnfollowDialog inherits Overlay {
    in property <string> message;
    callback accepted(remove: bool);

    title: @tr("Unfollow the podcast");
    // three buttons on one line, their French labels the longest
    panel-width: 520px;

    Text {
        text: root.message;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button { text: @tr("Keep on the device"); clicked => { root.accepted(false); } }
        Button { text: @tr("Remove from the device"); clicked => { root.accepted(true); } }
    }
}

export component LoginDialog inherits Overlay {
    in-out property <string> email;
    in-out property <string> password;
    callback accepted();

    title: @tr("LuniiStore credentials");
    panel-width: 340px;

    Text { text: "Email:"; }
    email-edit := LineEdit {
        text <=> root.email;
        accepted => { password-edit.focus(); }
    }
    Text { text: @tr("Password:"); }
    password-edit := LineEdit {
        text <=> root.password;
        input-type: InputType.password;
        accepted => { root.accepted(); }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button { text: "Login"; primary: true; clicked => { root.accepted(); } }
    }

    init => { email-edit.focus(); }
}

component NmOption inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    spacing: 2px;

    CheckBox {
        text: root.label;
        enabled: root.enabled;
        checked <=> root.checked;
    }
    if root.description != "": Text {
        text: root.description;
        wrap: word-wrap;
        font-size: 12px;
        opacity: root.enabled && root.checked ? 1 : 0.5;
    }
}

export component NightModeDialog inherits Overlay {
    in-out property <bool> nm-enabled;
    in-out property <bool> nm-limit;
    in-out property <bool> nm-autoplay;
    in-out property <int> nm-max-stories: 3;
    in-out property <bool> nm-turnoff;
    callback accepted();
    callback open-guide();

    title: @tr("Night mode settings");
    panel-width: 520px;

    HorizontalLayout {
        spacing: 14px;
        Image {
            source: root.nm-enabled ? @image-url("../../res/bg_night_mode.png") : @image-url("../../res/bg_day_mode.png");
            width: 150px;
            height: 150px;
            image-fit: contain;
        }
        VerticalLayout {
            alignment: center;
            spacing: 8px;
            Text {
                text: @tr("Configure Night Mode");
                font-size: 20px;
                font-weight: 700;
                wrap: word-wrap;
            }
            Link {
                text: @tr("Official Lunii Guide");
                clicked => { root.open-guide(); }
            }
        }
    }

    NmOption {
        label: @tr("Night mode");
        checked <=> root.nm-enabled;
    }
    NmOption {
        label: @tr("Limit Volume");
        description: @tr("The volume will be kept low for a calm listening experience conducive to falling asleep.");
        enabled: root.nm-enabled;
        checked <=> root.nm-limit;
    }
    NmOption {
        label: @tr("Keep playing with next");
        description: @tr("You can choose how many stories will be read before the device shuts down.");
        enabled: root.nm-enabled;
        checked <=> root.nm-autoplay;
    }
    HorizontalLayout {
        padding-left: 28px;
        spacing: 8px;
        Text {
            text: @tr("Max stories to play");
            vertical-alignment: center;
            opacity: root.nm-enabled && root.nm-autoplay ? 1 : 0.5;
        }
        SpinBox {
            minimum: 1;
            maximum: 8;
            value <=> root.nm-max-stories;
            enabled: root.nm-enabled && root.nm-autoplay;
            width: 90px;
        }
    }
    NmOption {
        label: @tr("Turn off after sleep");
        description: @tr("By enabling this feature, the device will automatically return to Day Mode after shutting down.");
        enabled: root.nm-enabled;
        checked <=> root.nm-turnoff;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button { text: @tr("Save"); primary: true; clicked => { root.accepted(); } }
    }
}

export component AboutDialog inherits Overlay {
    in property <string> version;
    callback open-url(url: string);

    title: @tr("About");
    panel-width: 600px;

    HorizontalLayout {
        spacing: 16px;
        Image {
            source: @image-url("../../res/lunii_about.png");
            height: 220px;
            image-fit: contain;
        }
        VerticalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "Lunii " + root.version;
                font-size: 20px;
                font-weight: 700;
            }
            Text {
                text: @tr("This application is a PoC that allows to manage the contents of your own Lunii Storyteller, including changing stories order, backup (for personal usage only), restore, and downloading your latest Lunii firmware (to eventually restore from a broken device).");
                wrap: word-wrap;
            }
            Text { text: @tr("Powered by Rust and Slint"); }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: @tr("Icons are provided freely by"); }
                Link { text: "icons8"; clicked => { root.open-url("https://icons8.com"); } }
            }
            Text { text: @tr("Logos are provided by malexxx"); }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: "URL :"; font-weight: 700; }
                Link {
                    text: "https://github.com/o-daneel/Lunii.QT";
                    clicked => { root.open-url("https://github.com/o-daneel/Lunii.QT"); }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        Button { text: "OK"; primary: true; clicked => { root.close(); } }
    }
}

/// Technical information of the opened storyteller.
export component DeviceInfoDialog inherits Overlay {
    in property <[InfoRow]> rows;
    // raw details (keys...), monospace
    in property <string> details;
    callback copy();
    callback open-folder();

    title: @tr("Device information");
    panel-width: 620px;

    VerticalLayout {
        spacing: 6px;
        for row in root.rows: HorizontalLayout {
            spacing: 16px;
            Text {
                text: row.label;
                width: 150px;
                font-weight: 700;
                horizontal-alignment: right;
            }
            Text {
                text: row.value;
                // fixed width: the height of the wrapped lines (long path) is right
                width: root.panel-width - 150px - 16px - 2 * 14px;
                wrap: word-wrap;
            }
        }
    }
    Text {
        text: @tr("Technical details");
        font-weight: 700;
    }
    Rectangle {
        background: Palette.alternate-background;
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        VerticalLayout {
            padding: 8px;
            Text {
                text: root.details;
                font-family: Theme.mono-font;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Button { text: @tr("Open the folder"); clicked => { root.open-folder(); } }
        Button { text: @tr("Copy"); clicked => { root.copy(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "OK"; primary: true; clicked => { root.close(); } }
    }
}

/// "+" of the Podcasts view: a podcast searched by its name (Apple Podcasts)
/// or loaded from its address, checked before being followed.
export component AddPodcastDialog inherits Overlay {
    in-out property <string> query;
    in property <[PodcastResult]> results;
    in property <int> selected: -1;
    // a search or a feed being loaded
    in property <bool> working;
    // result of the check of the feed, or the error
    in property <string> message;
    in property <bool> message-error;
    // a feed was checked
    in property <bool> can-follow;
    callback submit();
    callback choose(index: int);
    callback follow();

    title: @tr("Add a podcast");
    panel-width: 560px;
    init => { query-edit.focus(); }

    HorizontalLayout {
        spacing: 6px;
        query-edit := LineEdit {
            text <=> root.query;
            placeholder-text: @tr("Podcast name or address");
            accepted => { root.submit(); }
        }
        if !root.working: Button {
            text: @tr("Search");
            // as the spinner replacing it: the field does not move
            width: 110px;
            enabled: root.query != "";
            clicked => { root.submit(); }
        }
        if root.working: Rectangle {
            width: 110px;
            Spinner {
                indeterminate: true;
                width: 22px;
                height: 22px;
            }
        }
    }
    Text {
        text: @tr("Search a podcast by its name, or paste the address of its RSS feed, of its page or its Apple Podcasts link.");
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.hidden-text;
    }
    if root.results.length > 0: Rectangle {
        height: min(290px, root.results.length * 54px + 2px);
        border-width: 1px;
        border-color: Palette.border;
        ListView {
            for row[i] in root.results: Rectangle {
                height: 54px;
                background: i == root.selected ? Theme.selection : result-area.has-hover && row.available ? #8882 : transparent;
                result-area := TouchArea {
                    enabled: row.available;
                    mouse-cursor: row.available ? pointer : default;
                    clicked => { root.choose(i); }
                }
                HorizontalLayout {
                    padding: 5px;
                    padding-left: 6px;
                    // the scrollbar
                    padding-right: 14px;
                    spacing: 8px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 4px;
                        background: #8883;
                        clip: true;
                        Image {
                            source: row.image;
                            width: 44px;
                            height: 44px;
                            image-fit: cover;
                            opacity: row.available ? 1 : 0.4;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: row.title;
                            overflow: elide;
                            font-weight: 600;
                            color: i == root.selected ? #fff : row.available ? Palette.foreground : Theme.hidden-text;
                        }
                        Text {
                            text: row.info;
                            font-size: 11px;
                            overflow: elide;
                            color: i == root.selected ? #fff : Theme.hidden-text;
                        }
                    }
                }
            }
        }
    }
    if root.message != "": Text {
        text: root.message;
        wrap: word-wrap;
        color: root.message-error ? Theme.warning : Palette.foreground;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: @tr("Cancel"); clicked => { root.close(); } }
        Button {
            text: @tr("Follow");
            primary: true;
            enabled: root.can-follow && !root.working;
            clicked => { root.follow(); }
        }
    }
}
